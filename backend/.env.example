# AcoustID - FREE, register at https://acoustid.org/login (no credit card)
# After login go to: https://acoustid.org/api-key
ACOUSTID_API_KEY=your_free_key_here

# PostgreSQL — password must match POSTGRES_PASSWORD in docker-compose.yml
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_random_password

# App settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=500

# Admin login credentials (change these!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_real_password_here

# Secret key for JWT signing — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_run_python3_-c_"import_secrets;print(secrets.token_hex(32))"
JWT_EXPIRE_HOURS=24
